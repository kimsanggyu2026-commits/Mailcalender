# 한 번에 가져올 메일 개수
MAX_EMAILS=30

# 가져올 메일 검색 쿼리 (Gmail 검색 문법)
#  예) "is:unread newer_than:2d"  / "in:inbox newer_than:1d"  / "is:important newer_than:7d"
GMAIL_QUERY=is:unread newer_than:2d

# 보고서/ICS 출력 폴더
OUTPUT_DIR=output

# (선택) Google OAuth 파일 경로 — 기본값 그대로 두어도 됩니다
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# (선택) 텔레그램 알림 — 둘 다 설정해야 동작, 없으면 알림 건너뜀
#  1) @BotFather 에게 /newbot 으로 봇 생성 → 토큰 발급
#  2) 봇과 1:1 대화 시작 후 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (선택) Notion 누적 저장 — NOTION_TOKEN + (DATABASE_ID 또는 PAGE_ID) 필요
#  - DATABASE_ID 설정 시: 실행마다 DB에 새 페이지 생성(일별 누적, 권장)
#  - PAGE_ID 설정 시: 지정 페이지 하단에 매번 섹션 추가(한 페이지에 누적)
#  통합 시크릿은 https://www.notion.so/my-integrations 에서 발급 후, 대상 DB/페이지를 통합과 '연결'
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PAGE_ID=
