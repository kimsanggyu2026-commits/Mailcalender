# 한 번에 가져올 메일 개수
MAX_EMAILS=30

# 가져올 메일 검색 쿼리 (Gmail 검색 문법)
#  예) "is:unread newer_than:2d"  / "in:inbox newer_than:1d"  / "is:important newer_than:7d"
GMAIL_QUERY=is:unread newer_than:2d

# 보고서/ICS 출력 폴더
OUTPUT_DIR=output

# (선택) Google OAuth 파일 경로 — 기본값 그대로 두어도 됩니다
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
